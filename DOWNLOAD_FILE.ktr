  <step>
    <name>get_file_path</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DM_analytic</connection>
    <sql>/*
SELECT 'https://graph.microsoft.com/v1.0/me/drive/root:/Projects/Report_Daily/Report_Failed_Delivery_205/Daily/Daily_Failed_Delivery_205_Detail_${SOURCE}.xlsx' AS url_get_link_download 
		, 'Daily_Failed_Delivery_205_Detail_${SOURCE}.xlsx' AS filename
		, 'C:\Karno\Anteraja\story\S119\Weekly_Report_Failed_Delivery_80\Daily_Failed_Delivery_205_Detail_${SOURCE}.xlsx' AS dest_download  
--C:\Karno\Anteraja\story\S119\Weekly_Report_Failed_Delivery_80\Daily_Failed_Delivery_205_Detail_20240811.xlsx
*/

SELECT 
    TO_CHAR(date, 'YYYY-MM-DD') 														AS startdate, 
    TO_CHAR(date + INTERVAL '1 day', 'YYYY-MM-DD') 										AS enddate,
   concat('Daily_Failed_Delivery_205_Detail_',TO_CHAR(date, 'YYYYMMDD'),'.xlsx')		AS filename,
	CONCAT('${PATH}/Daily_Failed_Delivery_205_Detail_',TO_CHAR(date, 'YYYYMMDD'),'.xlsx') as file_path,
	CONCAT('${PATH}/Daily_Failed_Delivery_205_Detail_',TO_CHAR(date, 'YYYYMMDD'),'.xlsx') AS dest_download,
	CONCAT('https://graph.microsoft.com/v1.0/me/drive/root:/Projects/Report_Daily/Report_Failed_Delivery_205/Daily/Daily_Failed_Delivery_205_Detail_',TO_CHAR(date, 'YYYYMMDD'),'.xlsx') AS url_get_link_download
FROM (
    SELECT generate_series((NOW()::date), NOW()::date, INTERVAL '1 day') AS date
) AS date_series
WHERE date &lt;= NOW()::date;
</sql>
