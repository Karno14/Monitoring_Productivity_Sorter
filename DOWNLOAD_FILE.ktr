    <connection>DM_analytic</connection>
    <sql>select description::json ->> 'id'                       id
     , description::json ->> 'url_authorize'            url_authorize
     , description::json ->> 'url_token'                url_token
     , description::json ->> 'tenant_id'                tenant_id
     , description::json ->> 'client_id'                client_id
     , description::json ->> 'response_type'            response_type
     , description::json ->> 'response_mode'            response_mode
     , description::json ->> 'redirect_uri'             redirect_uri
     , description::json ->> 'scope'                    scope
     , description::json ->> 'grant_type'               grant_type
     , description::json ->> 'client_secret'            client_secret
     , description::json ->> 'uri_authorization_string' uri_authorization_string
     , description::json ->> 'uri_token_string'         uri_token_string
     , description::json ->> 'code'                     code
     , description::json ->> 'Content-Type-urlencode'   "Content-Type-urlencode"
from analysis_services.config_process_switch
where process_name = 'config_upload_onedrive_finance';</sql>
