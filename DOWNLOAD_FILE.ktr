    <definitions>
      <definition>
        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source>import org.pentaho.di.trans.steps.userdefinedjavaclass.*;
import org.pentaho.di.trans.step.*;
import org.pentaho.di.core.row.*;
import org.pentaho.di.core.*;
import org.pentaho.di.core.exception.*;

import java.util.*;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.sql.*;
import java.time.format.DateTimeFormatter;
import java.time.temporal.ChronoUnit;


String tenant_idField;
String client_idField;
String response_typeField;
String redirect_uriField;
String response_modeField;

String urlTokenField;
String uriTokenStringField;
 
public boolean processRow(StepMetaInterface smi, StepDataInterface sdi) throws KettleException
{
    // Let's look up parameters only once for performance reason.
    //
    if (first) {
      tenant_idField = getParameter("TENANT_ID");
	  client_idField = getParameter("CLIENT_ID");
	  response_typeField = getParameter("RESPONSE_TYPE");
	  redirect_uriField = getParameter("REDIRECT_URI");
	  response_modeField = getParameter("RESPONSE_MODE");
	  
	  urlTokenField = getParameter("URL_TOKEN");
      uriTokenStringField = getParameter("URI_TOKEN_STRING");

      first=false;
    }
 
    // First, get a row from the default input hop
    //
    Object[] r = getRow();
 
    // If the row object is null, we are done processing.
    //
    if (r == null) {
      setOutputDone();
      return false;
    }
 
    // It is always safest to call createOutputRow() to ensure that your output row's Object[] is large
    // enough to handle any new fields you are creating in this step.
    //
    Object[] outputRow = createOutputRow(r, data.outputRowMeta.size());
 
    String tenantId = get(Fields.In, tenant_idField).getString(r);
	String client_id = get(Fields.In, client_idField).getString(r);
	String response_type = get(Fields.In, response_typeField).getString(r);
	String redirect_uri = get(Fields.In, redirect_uriField).getString(r);
	String response_mode = get(Fields.In, response_modeField).getString(r);
	
	String urlToken = get(Fields.In, urlTokenField).getString(r);
	
	String uriString;
	uriString = urlToken.replace("${tenant_id}",tenantId);
	uriString = uriString.replace("${client_id}",client_id);
	uriString = uriString.replace("${response_type}",response_type);
	uriString = uriString.replace("${redirect_uri}",redirect_uri);
	uriString = uriString.replace("${response_mode}",response_mode);

	get(Fields.Out, uriTokenStringField).setValue(outputRow, uriString);


    // putRow will send the row on to the default output hop.
    //
    putRow(data.outputRowMeta, outputRow);
 
    return true;
}</class_source>
      </definition>
