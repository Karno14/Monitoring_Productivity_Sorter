    ) nik),
awb as (select unnest(array [${AWB_NUMBER}]) awb),
 baseA AS (
 select waybill_no awb,
   oper_time        tanggal,
   bar_opr_code      nik,
--          COALESCE(sr.flag, '-')           sorting_plan,sr.sorting_name,
   a.fzone_code      hub,
   a.extend_attach_7 as ext7,
     case
               when a.extend_attach_7 like '%:%' then trim(split_part(a.extend_attach_7, ':', 1))
               when a.extend_attach_7 ~ '[0-9]' then trim(regexp_replace(a.extend_attach_7, '[0-9].*$', ''))
               else a.extend_attach_7  end as ext7_res
 from analysis_services.fvp_603 a
--  left join dad_dev.sortingplan sr on a.extend_attach_7 like sr.sorting_name||'%'
 where 1=1
    AND a.oper_dt >=now()::date - interval '1 day'
    AND a.oper_dt &lt; now()::date - interval '0 day'
	AND a.oper_time >=now()::date - interval '1 day'
    AND a.oper_time &lt;now()::date-interval '0 day'
 and a.waybill_no >='1'
 and a.waybill_no &lt;'5' --AND a.waybill_no='11002043349315'
 and a.waybill_no in (select awb::text from awb)
),
base1 as (select awb,
                 tanggal,
                 nik,
                 hub,
                 ext7,sorting_name,
                 COALESCE(sr.flag, '-')           sorting_plan
    from baseA a
    left join dad_dev.sortingplan sr on a.ext7_res=sr.sorting_name
    ) --select * from base1;
,baseB as (
 SELECT  awb
  , tanggal
  , nik
  , sorting_plan
  , hub
  , CASE
   WHEN sorting_plan = 'Reguler' AND ext7 LIKE 'Primary%' THEN 'Primary'
   WHEN sorting_plan = 'Reguler' AND ext7 LIKE 'Secondary%' THEN 'Secondary'
   ELSE '-'
  END AS primsort
  , CASE
    WHEN LAG(sorting_plan) OVER (PARTITION BY awb, hub ORDER BY awb, sorting_plan, tanggal) IS NULL
         OR sorting_plan &lt;&gt; LAG(sorting_plan) OVER (PARTITION BY awb, hub ORDER BY awb, sorting_plan, tanggal)
    THEN 1
    ELSE 0
  END AS change_flag
  , ext7
 FROM base1
),
baseC as (
SELECT  awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , change_flag
 , SUM(change_flag) OVER (PARTITION BY awb, hub ORDER BY awb, tanggal) AS sort_group_number
 , ext7
 , primsort
FROM baseB
),
baseD AS (
SELECT  awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , ext7
 , change_flag
 , sort_group_number
 , row_number() over (partition by awb,hub, sorting_plan order by awb, sorting_plan, tanggal) seq_prim
 , row_number() over (partition by awb,hub, sorting_plan order by awb, sorting_plan, tanggal DESC) seq_second
 , primsort
FROM baseC
),
baseE as (
SELECT  awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , change_flag
 , sort_group_number
 , seq_prim
 , seq_second
 , ext7
 , CASE
  WHEN primsort= 'Secondary' THEN seq_second
  ELSE seq_prim
  END as seq_row
 , primsort
FROM baseD
), --select * from baseE;
hasil as (SELECT awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , ext7
 , change_flag
 , sort_group_number
 , seq_prim
 , seq_second
 , seq_row
 , primsort
 , row_number() over (partition by awb, hub  order by awb, tanggal) valid_row
FROM baseE
WHERE seq_row = 1 )
select
    tanggal::date tanggal
	, TO_CHAR(tanggal, 'HH24') || '.00 - ' || TO_CHAR(tanggal + INTERVAL '1 hour', 'HH24') || '.00' as hours
    , nik
    , b."name" nama
	, b.position_name	jabatan
    , d.new_region	region
    , ha.hub
    , d.hub_manager
    , sorting_plan
  --  , ext7
from hasil ha
inner join dad_sit.master_hub_manager d on d.hub = ha.hub
inner join analysis_services.tb_mv_tb_res_user b on ha.nik=b.loginid
   -- and position_name in ('SORTER HUB','SORTER GATEWAY')
where valid_row in (1,2)
	and (nik >='1' and nik &lt;'3' or  (b.loginid in (select nik from nik_dummy)))
and nik not in (select nik from analysis_services.tb_hcis_resign_date);</sql>
