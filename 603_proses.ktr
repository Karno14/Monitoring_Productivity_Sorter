    <connection>DM_analytic</connection>
    <sql>with nik_dummy as (select unnest(array['90000171','90000172','90000173','90000174','90000175','90001641','90001642','90001643','90001644','90001645','90001646','90001647','90001648','90001649','90001650','90001651','90001652','90001653','90001654','90001655','90003596','90003597','90003598','90003599','90003600','90003578','90003579','90003593','90003594','90003595','90003601','90003602','90003603','90003604','90003605','90042324','90042325','90042320','90042321','90042322','90042323','90042326','90047541','90031473','90031474','90031475','90031476','90031477','90031478','90031479','90031480','90031481','90031482','90005251','90005252','90013981','90013982','90013983','90005738','90005739','90005740','90005741','90005742','90003611','90003612','90003613','90003614','90003615','90003616','90003617','90003618','90003619','90003620','90003622','90005238','90005239','90005240','90004823','90004824','90004825','90004826','90004827','90003621','90031453','90031454','90031455','90031456','90031457','90031458','90031459','90031460','90031461','90031462','90005241','90005242','90005243','90005244','90005245','90005246','90005247','90005248',
'90005249','90005250','90031443','90031444','90031445','90031446','90031447','90031448','90031449','90031450','90031451','90031452','90031463','90031464','90031465','90031466','90031467','90031468','90031469','90031470','90031471','90031472','90031528','90031529','90031530','90031531','90031532','90031533','90031534','90031535','90031536','90031537','90042302','90036513','90031602','90042317','90042318','90042319','90042313','90042314','90042315','90042316','90034587','90034588','90034590','90034594','90034595','90030724','90030725','90030726','90030727','90030728','90030729','90030730','90030731','90030732','90030733','90036501','90036502','90036503','90036504','90040401','90040402','90040403','90040404','90040405','90040406','90034620','90036492','90036493','90036494','90036495','90036496','90036497','90036498','90036499','90036500','90040407','90040408','90040409','90040410','90040411','90040412','90040413','90040414','90040415','90040416','90034596','90034597','90034598','90034601','90034603','90034604','90034606','90034613','90034617','90034619','90040417','90040418','90040419',
'90040420','90041457','90041458','90041459','90041460','90041461','90041463','90041464','90041465','90041466','90041467','90041468','90041469','90041471','90041472','90041474','90041475','90031503','90031504','90031505','90031506','90031507','90031498','90031499','90031500','90031501','90031502','90031508','90031509','90031510','90031511','90031512','90031493','90031494','90031495','90031496','90031497','90031523','90031524','90031525','90031526','90031527','90042308','90042309','90042310','90042311','90042312','90042303','90042304','90042305','90042306','90042307','90030691','90030692','90030693','90030694','90030696','90030698','90030699','90030701','90030702','90030703','90030704','90030705','90030706','90030707','90030708','90030714','90030715','90030716','90030717','90030718','90030719','90030720','90030721','90030722','90030723','90030709','90030710','90030711','90030712','90030713','90041476','90041478','90041479','90041507','90041508','90041509','90041510','90041511','90041512','90041513','90041514','90041515','90041516','90041517','90041518','90041519','90041520','90030845',
'90030846','90030847','90030848','90030849','90030850','90030851','90030852','90001656','90001657','90001658','90001659','90001660','90003573','90003574','90003575','90003576','90003577','90003606','90003607','90003608','90003609','90003610','90031488','90031489','90031490','90031491','90031492','90031483','90031484','90031485','90031486','90031487','90031518','90031519','90031520','90031521','90031522','90031513','90031514','90031515','90031516','90031517','90014067','90014068','90014069','90014070','90014071','90030853','90030854','90014064','90014065','90014066','90031558','90031559','90031560','90031561','90031562','90031553','90031554','90031555','90031556','90031557','90031568','90031569','90031570','90031571','90031572','90031563','90031564','90031565','90031566','90031567','90031573','90031574','90031575','90031576','90031577','90004852','90004853','90004855','90004856','90004857','90031403','90031404','90031405','90031406','90031407','90031423','90031424','90031425','90031426','90031427','90011685','90011686','90011688','90011689','90011692','90011693','90011694','90011695',
'90011696','90011697','90014056','90014057','90014058','90014059','90014060','90014021','90014022','90014023','90014054','90014055','90030686','90030687','90030688','90030689','90030690','90011698','90011699','90014005','90014006','90014007','90014008','90014009','90014010','90014011','90014012','90014013','90014015','90014016','90014017','90014020','90011671','90011673','90011675','90011677','90011678','90011679','90011681','90011682','90011683','90011684','90014061','90014062','90014063','90030684','90030685','90014072','90014073','90030855','90030856','90030857','90031408','90031409','90031410','90031411','90031412','90030858','90030859','90030860','90030861','90030862','90030863','90030864','90030865','90030866','90030867','90031413','90031414','90031415','90031416','90031417','90031538','90031539','90031540','90031541','90031542','90031543','90031544','90031545','90031546','90031547','90031548','90031549','90031550','90031551','90031552','90031583','90031584','90031585','90031586','90031587','90031578','90031579','90031580','90031581','90031582','90031418','90031419','90031420','90031421','90031422','90031588','90031589','90031590','90031591','90031592','90031596','90031597','90031598','90031593','90031594','90031595','90031599','90031600','90031601','90030868','90030869','90004848','90004850','90004851']
    ) nik),
--awb as (select unnest(array [${AWB_NUMBER}]) awb),
 baseA AS (
 select waybill_no awb,
   oper_time        tanggal,
   bar_opr_code      nik,
--          COALESCE(sr.flag, '-')           sorting_plan,sr.sorting_name,
   a.fzone_code      hub,
   a.extend_attach_7 as ext7,
     case
               when a.extend_attach_7 like '%:%' then trim(split_part(a.extend_attach_7, ':', 1))
               when a.extend_attach_7 ~ '[0-9]' then trim(regexp_replace(a.extend_attach_7, '[0-9].*$', ''))
               else a.extend_attach_7  end as ext7_res
 from analysis_services.fvp_603 a
--  left join dad_dev.sortingplan sr on a.extend_attach_7 like sr.sorting_name||'%'
 where 1=1
    AND a.oper_dt >=now()::date - interval '3 day'
    AND a.oper_dt &lt; now()::date - interval '2 day'
	AND a.oper_time >=now()::date - interval '3 day'
    AND a.oper_time &lt;now()::date-interval '2 day'
 and a.waybill_no >='1'
 and a.waybill_no &lt;'5' --AND a.waybill_no='11002043349315'
 --and a.waybill_no in (select awb::text from awb)
),
base1 as (select awb,
                 tanggal,
                 nik,
                 hub,
                 ext7,sorting_name,
                 COALESCE(sr.flag, '-')           sorting_plan
    from baseA a
    left join dad_dev.sortingplan sr on a.ext7_res=sr.sorting_name
    ) --select * from base1;
,baseB as (
 SELECT  awb
  , tanggal
  , nik
  , sorting_plan
  , hub
  , CASE
   WHEN sorting_plan = 'Reguler' AND ext7 LIKE 'Primary%' THEN 'Primary'
   WHEN sorting_plan = 'Reguler' AND ext7 LIKE 'Secondary%' THEN 'Secondary'
   ELSE '-'
  END AS primsort
  , CASE
    WHEN LAG(sorting_plan) OVER (PARTITION BY awb, hub ORDER BY awb, sorting_plan, tanggal) IS NULL
         OR sorting_plan &lt;&gt; LAG(sorting_plan) OVER (PARTITION BY awb, hub ORDER BY awb, sorting_plan, tanggal)
    THEN 1
    ELSE 0
  END AS change_flag
  , ext7
 FROM base1
),
baseC as (
SELECT  awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , change_flag
 , SUM(change_flag) OVER (PARTITION BY awb, hub ORDER BY awb, tanggal) AS sort_group_number
 , ext7
 , primsort
FROM baseB
),
baseD AS (
SELECT  awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , ext7
 , change_flag
 , sort_group_number
 , row_number() over (partition by awb,hub, sorting_plan order by awb, sorting_plan, tanggal) seq_prim
 , row_number() over (partition by awb,hub, sorting_plan order by awb, sorting_plan, tanggal DESC) seq_second
 , primsort
FROM baseC
),
baseE as (
SELECT  awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , change_flag
 , sort_group_number
 , seq_prim
 , seq_second
 , ext7
 , CASE
  WHEN primsort= 'Secondary' THEN seq_second
  ELSE seq_prim
  END as seq_row
 , primsort
FROM baseD
), --select * from baseE;
hasil as (SELECT awb
 , tanggal
 , nik
 , sorting_plan
 , hub
 , ext7
 , change_flag
 , sort_group_number
 , seq_prim
 , seq_second
 , seq_row
 , primsort
 , row_number() over (partition by awb, hub  order by awb, tanggal) valid_row
FROM baseE
WHERE seq_row = 1 )
select
    tanggal::date tanggal
	, TO_CHAR(tanggal, 'HH24') || '.00 - ' || TO_CHAR(tanggal + INTERVAL '1 hour', 'HH24') || '.00' as hours
    , nik
    , b."name" nama
	, b.position_name	jabatan
    , d.new_region	region
    , ha.hub
    , d.hub_manager
    , sorting_plan
  --  , ext7
from hasil ha
inner join dad_sit.master_hub_manager d on d.hub = ha.hub
inner join analysis_services.tb_mv_tb_res_user b on ha.nik=b.loginid
   -- and position_name in ('SORTER HUB','SORTER GATEWAY')
where valid_row in (1,2)
	and (nik >='1' and nik &lt;'3' or  (b.loginid in (select nik from nik_dummy)))
and nik not in (select nik from analysis_services.tb_hcis_resign_date);</sql>
