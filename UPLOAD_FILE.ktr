  <step>
    <name>Resumable File Upload</name>
    <type>UserDefinedJavaClass</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <definitions>
      <definition>
        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source>import org.apache.http.HttpEntity;
import org.apache.http.HttpHeaders;
import org.apache.http.HttpResponse;
import org.apache.http.client.HttpClient;
import org.apache.http.client.methods.HttpPost;
import org.apache.http.client.methods.HttpPut;
import org.apache.http.entity.FileEntity;
import org.apache.http.entity.StringEntity;
import org.apache.http.impl.client.HttpClients;
import org.apache.http.util.EntityUtils;
import org.json.JSONObject;

import java.io.File;
import java.io.IOException;
import java.io.RandomAccessFile;
import java.nio.channels.FileChannel;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.List;
import java.util.UUID;


// YANG PERLU DIUBAH
// 1. Satuan pecahan file yang akan di Split => #UbahBesaranMBPerFile

public boolean processRow(StepMetaInterface smi, StepDataInterface sdi) throws KettleException
{


	Object[] r = getRow();
 
    if (r == null) {
        setOutputDone();
        return false;
    }

	 r = createOutputRow(r, data.outputRowMeta.size());
 
  	// Get the value from url
    //String urlString = get(Fields.In, "url").getString(r);


	// Get the file name 
	String longFileNameString = get(Fields.In, "path_and_filename").getString(r);

	// shortFileNameString = namafile yang akan di upload
	String shortFileNameString = get(Fields.In, "short_filename").getString(r);

	// Ambil dari Get Variable
	 String workingDirectory = get(Fields.In, "temp_directory_for_working").getString(r) + "/";
	//String workingDirectory = "C:\\Users\\Andreas_93rnbgz\\OneDrive - PT. Tri Adi Bersama\\anteraja\\RnD\\TestJavaClassPentaho\\splitted_files\\";
	
	logBasic("Working Directory="+workingDirectory);
	logBasic("filename="+longFileNameString);
	logBasic("short_filename="+shortFileNameString);
	//String workingDirectory2 = get(Fields.In, "working_directory2").getString(r) + "/";
	//logBasic("working_directory2="+workingDirectory2);
	// Remove file:///
	//workingDirectory = workingDirectory.substring(8, workingDirectory.length());
	

	//String longFileNameString = "C:\\Users\\Andreas_93rnbgz\\Documents\\Dev\\TestJavaClassPentaho\\TestJavaClassPentaho.iml";

	// Load the file
	File file = new File(longFileNameString);

	// ================================= Create Upload Session / Ticket =================================
	// String urlString = "https://graph.microsoft.com/v1.0//me/drive/root:/Finance/Transaction/"+file.getName()+":/createUploadSession";
	// String urlString = "https://graph.microsoft.com/v1.0//me/drive/root:/Projects/ACA/ACADaily/"+shortFileNameString+":/createUploadSession";
	//String urlString = "https://graph.microsoft.com/v1.0//me/drive/root:/Operations/DELIVERY_DETAIL_SLA/Weekly_Detail/"+shortFileNameString+":/createUploadSession";
	//String urlString = "https://graph.microsoft.com/v1.0//me/drive/root:/DAD_SIT/Testing_ASE/"+shortFileNameString+":/createUploadSession";
    //String urlShareString = "https://graph.microsoft.com/v1.0//me/drive/root:/DAD_SIT/Testing_ASE/"+shortFileNameString+":/createLink";
    String urlString = "${link_folder}"+shortFileNameString+":/createUploadSession";
    String urlShareString = "${link_folder}/"+shortFileNameString+":/createLink";
	String urlFolderShareString = "${link_folder}:/createLink";

//"https://graph.microsoft.com/v1.0//me/drive/root:/Operations/"+shortFileNameString+":/createUploadSession";

	//logBasic("Parameter urlString="+urlString);

	String bearerToken = get(Fields.In, "bearerToken").getString(r);


    HttpPost httpPost = new HttpPost(urlString);

    String json = "{\n" +
            "  \"@microsoft.graph.conflictBehavior\": \"replace\",\n" +
            "  \"description\": \"description\",\n" +
            "  \"fileSystemInfo\": { \"@odata.type\": \"microsoft.graph.fileSystemInfo\" },\n" +
            "  \"name\": \""+shortFileNameString+"\"\n" +
            "}";


    StringEntity entity = null;
    try {
        entity = new StringEntity(json);
    } catch (Exception e) {
        e.printStackTrace();
    }

    httpPost.setEntity(entity);

    httpPost.setHeader(HttpHeaders.AUTHORIZATION, bearerToken);
    httpPost.setHeader("Accept", "application/json");
    httpPost.setHeader("Content-type", "application/json");

    HttpClient httpClient = HttpClients.createDefault();


    String httpResponseString = "";
	String httpResponseBody = "";
	String uploadUrl = ""; 

	logBasic("Parameter urlString="+urlString);

    try{
        //Make HTTP Call
        HttpResponse response = httpClient.execute(httpPost);
        HttpEntity entityResponse = response.getEntity();
        // Check if response code is as expected
        if (response.getStatusLine().getStatusCode() != 200) {

        }

        httpResponseBody = EntityUtils.toString(entityResponse, "UTF-8");

		httpResponseString = response.toString();

        JSONObject obj = new JSONObject(httpResponseBody);

        uploadUrl = obj.getString("uploadUrl");

        logBasic("Parameter httpResponseString="+httpResponseString);
        logBasic("Parameter httpResponseBody="+httpResponseBody);
		logBasic("Parameter uploadUrl="+uploadUrl);


		//test("HIIIII");
        // Set value of HTTP Status, integer values need conversion
    } catch (Exception e) {
        // Set value of HTTP Status to -1 since HTTP Post caused exception
		httpResponseString = e.getMessage();
    }


	// ================================= MULAI UNTUK PECAH FILE DAN UPLOAD =================================

    if (uploadUrl != null &amp;&amp; !"".equals(uploadUrl)) {

        String fileName = longFileNameString;

		// #UbahBesaranMBPerFile
		// BESAR PECAHAN PER FILE NYA
		// Satuannya MB
        Integer mBperSplit = 50;

        String dir = workingDirectory;

        String suffix = ".splitPart";

        String partFiles[] = new String[]{};
        

        final long sourceSize;

        try {


			// ================================= START SPLIT FILE =================================
            sourceSize = Files.size(Paths.get(fileName));
            final long bytesPerSplit = 1024L * 1024L * mBperSplit;
            final long numSplits = sourceSize / bytesPerSplit;
            final long remainingBytes = sourceSize % bytesPerSplit;
            int position = 0;

            System.out.println("=== INITIAL =======");
            System.out.println("bytesPerSplit : " + bytesPerSplit);
            System.out.println("numSplits : " + numSplits);

            RandomAccessFile sourceFile = null;

            sourceFile = new RandomAccessFile(fileName, "r");
            FileChannel sourceChannel = sourceFile.getChannel();


            for (position = 0; position &lt; numSplits; position++) {
                //write multipart files.
                partFiles = writePartToFile2(bytesPerSplit, position * bytesPerSplit, sourceChannel, partFiles, dir, suffix);
            }

            if (remainingBytes > 0) {
                partFiles = writePartToFile2(remainingBytes, position * bytesPerSplit, sourceChannel, partFiles, dir, suffix);
            }


			//================================= START UPLOAD FILE SATU PER SATU SEQUENCTIALLY=================================
            /**
             * START TO UPLOAD
             */
            //System.out.println("Total : " + Files.size(Paths.get(fileName)));

            Integer totalContentLength = Math.toIntExact(Files.size(Paths.get(fileName)));
            Integer lastContentRange = 0;
            Integer firstContentRange = 0;
            String contentLength = "";
            String contentRange = "";

            longFileNameString = "";

            for (String str: partFiles) {

                longFileNameString = String.valueOf(str);

                File fileSplitted = new File(longFileNameString);

                //                    System.out.println("File Exists : " + file.exists());

                lastContentRange = firstContentRange + Math.toIntExact(Files.size(Paths.get(String.valueOf(str)))) - 1;

                contentLength = String.valueOf(Files.size(Paths.get(String.valueOf(str))));
                contentRange = "bytes " +firstContentRange + "-" + lastContentRange + "/" + totalContentLength;

                //System.out.println("Content-Length :" + contentLength);
                //System.out.println("Content-Range : " + contentRange);


                // ============= UPLOAD THE FILE ===============
                //System.out.println("=========== START UPLOAD FILES =============");
				logBasic("=========== START UPLOAD FILES =============");

                HttpPut put = new HttpPut(uploadUrl);
                put.addHeader(HttpHeaders.CONTENT_RANGE, contentRange);
                //                    System.out.println("uploadUrl : " + uploadUrl);
                put.addHeader(HttpHeaders.AUTHORIZATION, bearerToken);
                put.addHeader(HttpHeaders.CONTENT_TYPE, "application/octet-stream");
                //                    put.addHeader(HttpHeaders.CONTENT_LENGTH, contentLength);


                FileEntity fileEntity = new FileEntity(fileSplitted,"binary/octet-stream");

                put.setEntity(fileEntity);

                HttpClient httpClientPut = HttpClients.createDefault();

                try{
                    //Make HTTP Call
                    HttpResponse responsePut = httpClientPut.execute(put);
                    HttpEntity entityResponsePut = responsePut.getEntity();
                    // Check if response code is as expected
                    if (responsePut.getStatusLine().getStatusCode() != 200) {

                    }


                    //System.out.println( "response.getStatusLine().getStatusCode() : " + responsePut.getStatusLine().getStatusCode());
					logBasic("response.getStatusLine().getStatusCode() : " + responsePut.getStatusLine().getStatusCode());

                    logBasic("response.toString() : " + responsePut.toString());

                    String responseString = EntityUtils.toString(entityResponsePut, "UTF-8");
                    //System.out.println("responseString : " + responseString);

                    // Set value of HTTP Status, integer values need conversion
                } catch (Exception e) {
                    // Set value of HTTP Status to -1 since HTTP Post caused exception
                    logBasic("Exception Sending Splitted Files");
                    logBasic(e.getMessage());
                }

                // ============= UPLOAD THE FILE ===============

                firstContentRange = lastContentRange + 1;

            }


            // Delete files
            for (String str: partFiles) {
                Files.delete(Paths.get(String.valueOf(str)));
            }


			sourceFile.close();
			sourceChannel.close();

        } catch (IOException e) {
            e.printStackTrace();
        }



    }

	//file.close();
	
    
	
	get(Fields.Out, "http_response").setValue(r,  httpResponseString);

    get(Fields.Out, "url_share").setValue(r,  urlShareString);

    get(Fields.Out, "url_folder_share").setValue(r,  urlFolderShareString);

	putRow(data.outputRowMeta, r);
 
	return true;
}



public void test(String message) {
	
	logBasic("Parameter message="+message);

}


public  String[] writePartToFile2(long byteSize, long position, FileChannel sourceChannel, String [] partFiles, String dir, String suffix)  {
    Path fileName = Paths.get(dir + UUID.randomUUID() + suffix);
    RandomAccessFile toFile = null;
    try  {
        toFile = new RandomAccessFile(fileName.toFile(), "rw");
        FileChannel toChannel = toFile.getChannel();
        sourceChannel.position(position);
        toChannel.transferFrom(sourceChannel, 0, byteSize);
		toFile.close();
		toChannel.close();
    } catch (IOException e) {
        e.printStackTrace();
    }
    //partFiles.add(fileName);
    partFiles = addArray(partFiles, String.valueOf(fileName));
    return partFiles;
}

public String[] addArray(String[] theArray, String newValue)
{
    int i = theArray.length;


    int n = ++i;

    String[] newArray = new String[n];
    for(int cnt=0;cnt&lt;theArray.length;cnt++)
    {
        newArray[cnt] = theArray[cnt];
    }

    newArray[n-1] = newValue;
    return newArray;
}


