    ) nik),
awb as ( select waybill_no awb,
		oper_time 					tanggal,
		bar_opr_code						nik,
		--b.service_code 						service,
		'Reguler' 							service,
		a.fzone_code						hub,
          row_number() over (partition by waybill_no,fzone_code order by oper_time) nomor_urut
	from analysis_services.fvp_31 a
	where  a.oper_dt >='${STARTDATE}'::date --now()::date - interval '2 day'
		and a.oper_dt &lt;'${ENDDATE}'::date --now()::date + interval '1 day'
		and a.oper_time >='${STARTDATE}'::date --now()::date - interval '1 day'
		and a.oper_time &lt; '${ENDDATE}'::date --now()::date - interval '0 day'
		and a.waybill_no >='1'
		and a.waybill_no &lt;'5'  ),
	hasil as (select
		date(a.tanggal) tanggal,
		TO_CHAR(tanggal, 'HH24') || '.00 - ' || TO_CHAR(tanggal + INTERVAL '1 hour', 'HH24') || '.00' as hours,--TO_CHAR(a.tanggal, 'HH24') hours,
		b.loginid nik,
		b."name",
		b.position_name	jabatan,
		case when a.hub>'' then a.hub
			else b.dept_code end as hub,
		count (*) filter (where service ='Reguler') 	total_reg,
		0 as total_big,
		0 as total_dok
	from analysis_services.tb_mv_tb_res_user b
	left join awb a on a.nik = b.loginid  and nomor_urut=1
		where loginid not in (select nik from analysis_services.tb_hcis_resign_date)
		--and position_name in ('SORTER HUB','SORTER GATEWAY')
		and ( (b.loginid >='1' and b.loginid &lt;'3') or  (b.loginid in (select nik from nik_dummy)))
		--and b.loginid in ('10006555','10006851', '30006968')
		group by 1,2,3,4,5,6)
		select tanggal,
			nik,
			"name",
			jabatan,
			d.new_region	region,
			a.hub,
			d.hub_manager,
			hours,
			total_reg,
			total_big,
			total_dok,
			(total_reg+total_big+total_dok) 		as total,
			'31' 								as flag
		from hasil a
		inner join dad_sit.master_hub_manager d on d.hub = a.hub</sql>
