  <step>
    <name>sheet 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DM_analytic</connection>
    <sql>with awb as (
    select --"FMAIN_WAYBILL_NO",
           "FBAR_SCAN_TM"                                                                                   tanggal,
           "FBAR_OPR_CODE"                                                                                  nik,
           sr.flag                                                                                          service,
           "FZONE_CODE"                                                                                     hub,
           case
               when "FOP_CODE" = '43' and "FEXTEND_ATTACHE_1" = 'ACCEPT ALL' then 'Normal'
               when "FOP_CODE" = '43' and "FEXTEND_ATTACHE_1" = 'SCAN PARCEL/BAG' then 'per parcel'
               when "FOP_CODE" = '21' and "FEXTEND_ATTACHE_1" = 'Normal Konsolidasi' then 'Normal'
               when "FOP_CODE" = '21' and "FEXTEND_ATTACHE_1" = 'Konsolidasi Per Parcel' then 'per parcel'
               when "FOP_CODE" = '30' and "FEXTEND_ATTACHE_1" = 'ACCEPT ALL' then 'Normal'
               when "FOP_CODE" = '30' and "FEXTEND_ATTACHE_1" = 'SCAN PARCEL/BAG' then 'per parcel'
               when "FOP_CODE" = '31' and "FEXTEND_ATTACHE_1" = 'ACCEPT ALL' then 'Normal'
               when "FOP_CODE" = '31' and "FEXTEND_ATTACHE_1" = 'SCAN PARCEL/BAG' then 'per parcel'
               when "FOP_CODE" = '640' and "FEXTEND_ATTACHE_1" = 'ACCEPT ALL' then 'Normal'
               when "FOP_CODE" = '640' and "FEXTEND_ATTACHE_1" = 'SCAN PARCEL/BAG' then 'per parcel' end as flaging,
           "FOP_CODE"                       flag
    from jvfvproute.tt_fvp_core_fact_route a
             left join lateral (select ff.extend_attach_7 ext7
                                from analysis_services.fvp_603 ff
                                where oper_dt >= now()::date - interval '3 month'
                                  and oper_dt &lt; now()::date
                                  and ff.waybill_no = a."FMAIN_WAYBILL_NO"
                                order by oper_time
                                limit 1
        ) fvp on true
             left join dad_dev.sortingplan sr on ext7 like sr.sorting_name || '%'
    where "FBAR_SCAN_TM" >= now()::date - interval '1 day'
      and "FBAR_SCAN_TM" &lt; now()::date-interval '0 day'
      and "FOP_CODE" in ('43', '30', '31','640')
      and "FMAIN_WAYBILL_NO" > '1'
      and "FMAIN_WAYBILL_NO" &lt; '5'
-- and "FMAIN_WAYBILL_NO"='11001297885413'
),
	hasil as (select 
		date(a.tanggal) tanggal,
		TO_CHAR(tanggal, 'HH24') || '.00 - ' || TO_CHAR(tanggal + INTERVAL '1 hour', 'HH24') || '.00' as hours,--TO_CHAR(a.tanggal, 'HH24') hours,
		b.loginid nik,
		b."name",
		b.position_name	jabatan,
		case when a.hub>'' then a.hub
			else b.dept_code end as hub,
	    flag,
-- 		count (*) filter (where service ='Reguler') 	total_reg,
	    count (*) filter (where service ='Reguler' and flaging='Normal') 	normal_reg,
	    count (*) filter (where service ='Reguler' and flaging='per parcel') 	perparcel_reg,
-- 		count (*) filter(where service = 'BP') as total_big,
	    count (*) filter (where service ='BP' and flaging='Normal') 	normal_big,
	    count (*) filter (where service ='BP' and flaging='per parcel') 	perparcel_big,
		count (*) filter(where service = 'DOK') as total_dok,
	    count (*) filter (where service ='DOK' and flaging='Normal') 	normal_dok,
	    count (*) filter (where service ='DOK' and flaging='per parcel') 	perparcel_dok
	from awb a
	left join analysis_services.tb_mv_tb_res_user b on a.nik = b.loginid
		where loginid not in (select nik from analysis_services.tb_hcis_resign_date)
		and position_name in ('SORTER HUB','SORTER GATEWAY')
		and b.loginid >='1' and b.loginid &lt;'3' or  (b.loginid in ('90000171',
            '90000172',
            '90000173',
            '90000174',
            '90000175',
            '90001641',
            '90001642',
            '90001643',
            '90001644',
            '90001645',
            '90001646',
            '90001647',
            '90001648',
            '90001649',
            '90001650',
            '90001651',
            '90001652',
            '90001653',
            '90001654',
            '90001655',
            '90003596',
            '90003597',
            '90003598',
            '90003599',
            '90003600',
            '90003578',
            '90003579',
            '90003593',
