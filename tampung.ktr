		--and b.loginid in ('10006555','10006851', '30006968')
		group by 1,2,3,4,5,6 )
		select tanggal,
			nik,
			"name",
			jabatan,
			d.new_region	region,
			a.hub,
			d.hub_manager,
			hours,
		    '21' flag,
			normal_reg,
		    perparcel_reg,
		    normal_reg+perparcel_reg    as total_reg,
			normal_big,
			perparcel_big,
		    normal_big+perparcel_big    as total_big,
		    normal_dok,
		    perparcel_dok,
			normal_dok+perparcel_dok    as total_dok
		from hasil a
		inner join dad_sit.master_hub_manager d on d.hub = a.hub</sql>
