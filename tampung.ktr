    <connection>DM_analytic</connection>
    <sql>with awb as (
--     explain
    select
           "FBAR_SCAN_TM"                                                                                   tanggal,
           "FBAR_OPR_CODE"                                                                                  nik,
--            sr.flag                                                                                          service,
           "FZONE_CODE"                                                                                     hub,
           case
              when "FEXTEND_ATTACHE_1" = 'Normal Konsolidasi' then 'Normal'
              when "FEXTEND_ATTACHE_1" = 'Konsolidasi Per Parcel' then 'per parcel'
              end as flaging,
           ext7
--            "FOP_CODE"                       flag
    from jvfvproute.tt_fvp_core_fact_route a
        inner join analysis_services.awb_summary aws on a."FMAIN_WAYBILL_NO"=aws.awb
            and order_time_dt>=now()::date-interval '2 month'
            and order_time_dt&lt;now()::date--interval '1 month'
            and "619_tm" is null
    left join lateral (select ff.extend_attach_7 ext7
                        from analysis_services.fvp_603 ff
                           where oper_dt >= now()::date - interval '3 month'
                            and oper_dt &lt; now()::date
                            and ff.waybill_no = a."FMAIN_WAYBILL_NO"
                            order by oper_time
                            limit 1
        ) fvp on true
--              left join dad_dev.sortingplan sr on ext7 like sr.sorting_name || '%'
    where "FBAR_SCAN_TM" >= now()::date - interval '1 day'
      and "FBAR_SCAN_TM" &lt; now()::date-interval '0 day'
      and "FOP_CODE" ='21'
      and "FMAIN_WAYBILL_NO" > '1'
      and "FMAIN_WAYBILL_NO" &lt; '5'
),
	hasil as (select
		date(a.tanggal) tanggal,
		TO_CHAR(tanggal, 'HH24') || '.00 - ' || TO_CHAR(tanggal + INTERVAL '1 hour', 'HH24') || '.00' as hours,--TO_CHAR(a.tanggal, 'HH24') hours,
		b.loginid nik,
		b."name",
		b.position_name	jabatan,
		case when a.hub>'' then a.hub
			else b.dept_code end as hub,
-- 	    a.flag,
-- 		count (*) filter (where service ='Reguler') 	total_reg,
	    count (*) filter (where sr.flag ='Reguler' and flaging='Normal') 	normal_reg,
	    count (*) filter (where sr.flag ='Reguler' and flaging='per parcel') 	perparcel_reg,
-- 		count (*) filter(where service = 'BP') as total_big,
	    count (*) filter (where sr.flag ='BP' and flaging='Normal') 	normal_big,
	    count (*) filter (where sr.flag ='BP' and flaging='per parcel') 	perparcel_big,
		count (*) filter(where sr.flag = 'DOK') as total_dok,
	    count (*) filter (where sr.flag ='DOK' and flaging='Normal') 	normal_dok,
	    count (*) filter (where sr.flag ='DOK' and flaging='per parcel') 	perparcel_dok
	from awb a
	left join analysis_services.tb_mv_tb_res_user b on a.nik = b.loginid
    left join dad_dev.sortingplan sr on ext7 like sr.sorting_name || '%'
		where loginid not in (select nik from analysis_services.tb_hcis_resign_date)
		and position_name in ('SORTER HUB','SORTER GATEWAY')
		and b.loginid >='1' and b.loginid &lt;'3' or  (b.loginid in ('90000171',
            '90000172',
            '90000173',
            '90000174',
            '90000175',
            '90001641',
