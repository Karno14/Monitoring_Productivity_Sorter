    ) nik),
awb as ( select "FMAIN_WAYBILL_NO" awb,
               "FBAR_SCAN_TM"  tanggal,
                    "FBAR_OPR_CODE" nik,
                    'Reguler' service,
                    "FZONE_CODE"    hub,
                    "FOP_CODE"      flag, --case when re.nik >'' then 'YES' else 'NO' end as resign,
                row_number() over (partition by "FMAIN_WAYBILL_NO", "FZONE_CODE","FOP_CODE"  order by "FBAR_SCAN_TM") nomor_urut
             from jvfvproute.tt_fvp_core_fact_route a
--         left join analysis_services.tb_hcis_resign_date re on a."FBAR_OPR_CODE"=re.nik
             where "FBAR_SCAN_TM" >='${STARTDATE}'::date --now()::date - interval '1 day'
               and "FBAR_SCAN_TM" &lt; '${ENDDATE}'::date --now()::date - interval '0 day'
               and "FOP_CODE" in ('45', '619', '41', '84','82','83','201','207','209','643')
               and a."FMAIN_WAYBILL_NO" >= '1'
               and a."FMAIN_WAYBILL_NO" &lt; '5' -- and "FBAR_OPR_CODE" in ('90031498')
),
 hasil as (select
		date(a.tanggal) tanggal,
		TO_CHAR(tanggal, 'HH24') || '.00 - ' || TO_CHAR(tanggal + INTERVAL '1 hour', 'HH24') || '.00' as hours,--TO_CHAR(a.tanggal, 'HH24') hours,
		b.loginid nik,
		b."name",
		b.position_name	jabatan,
        flag,
		case when a.hub>'' then a.hub
			else b.dept_code end as hub,
		count (*) filter ( where service='Reguler' ) 	total_reg,
		0 as total_big,
		0 as total_dok
	from analysis_services.tb_mv_tb_res_user b
	left join awb a on a.nik = b.loginid
		where 1=1  and loginid not in (select nik from analysis_services.tb_hcis_resign_date)
		--and position_name in ('SORTER HUB','SORTER GATEWAY')
		and nomor_urut=1
		and b.loginid >='1'
		and b.loginid &lt;'3'
or  (b.loginid in (select nik from nik_dummy))
		--and b.loginid='10006555'
		group by 1,2,3,4,5,6,7 )
		select tanggal,
			nik,
			"name",
			jabatan,
			d.new_region	region,
			a.hub,
			d.hub_manager,
			hours,
			total_reg,
			total_big,
			total_dok,
 			(total_reg+total_big+total_dok) 		as total,
			flag 								as flag
		from hasil a
		inner join dad_sit.master_hub_manager d on d.hub = a.hub;</sql>
