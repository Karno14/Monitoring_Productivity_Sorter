  <step>
    <name>Get email recipient</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DM_analytic</connection>
    <sql>SELECT split_part(cps.email, ' | ', 1)                                                                   email,
       split_part(cps.email, ' | ', 2)                                                                   cc_email,
       split_part(cps.email, ' | ', 3)                                                                   bcc_email,
	   link_folder,
       TO_CHAR(now() AT TIME ZONE 'Asia/Jakarta', 'dd FMMonth yyyy')                                  	AS tanggalan,
		TO_CHAR(now()::date-interval '2 day', 'yyyy-MM-dd')                                  	AS startdate,
		TO_CHAR(now()::date-interval '1 day', 'yyyy-MM-dd')                                  	AS enddate,
		TO_CHAR(now()::date-interval '1 day', 'yyyyMMdd')                                  	AS tgl,
	  'Daily_Report_Monitoring_Productivity_Sorter' || '(' || to_char((now() at time zone 'Asia/Jakarta')::date, 'DD-MM-YYYY') ||
		')'                                   															AS subject_mail,
       'Monitoring_Productivity_Sorter'         														AS subject_body,
       CASE
           WHEN '${ENVIRONTMENT}' = 'LOCAL' THEN '${Internal.Entry.Current.Directory}'
           WHEN '${ENVIRONTMENT}' = 'PROD'
               THEN 'file:///home/ubuntu/data-analytic-dept/project/aware/operation_report_upload/temp'
           END                                                                                        AS file_name_ars,
       CASE
           WHEN '${ENVIRONTMENT}' = 'LOCAL' THEN '${Internal.Entry.Current.Directory}'
           WHEN '${ENVIRONTMENT}' = 'PROD'
               THEN '/home/ubuntu/data-analytic-dept/project/aware/operation_report_upload/temp'
           END                                                                                        AS directory_ars,
       '${Internal.Job.Filename.Name}'                                                                AS job_name,
       cps.process_name,
       cpsb.description,
       cpsb.description::json ->> 'username'                                                          AS username,
       cpsb.description::json ->> 'password'                                                          AS password,
       cpsb.description::json ->> 'host'                                                              AS host,
       cpsb.description::json ->> 'port'                                                              AS port
FROM analysis_services.config_process_switch cps
         left join analysis_services.config_process_switch cpsb on cps.config_smtp = cpsb.process_name
WHERE cps.process_name = '${Internal.Job.Filename.Name}'
  AND cps.switch = true</sql>
    <limit>1</limit>
