  <step>
    <name>Summary By. Order DT</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DM_analytic</connection>
    <sql>select 
			tanggal,
			nik,
			name,
			region,
			hub,
			hub_manager,
			sum(else_) filter (where flag ='43') 	as  "43",
			sum(else_) filter (where flag ='603') 	as  "603",
			sum(else_) filter (where flag ='606') 	as  "604",
			sum(else_) filter (where flag ='21') 	as  "21",
			sum(else_) filter (where flag ='618') 	as  "618",
			sum(else_) filter (where flag ='30') 	as  "30",
			sum(else_) filter (where flag ='31') 	as  "31",
			sum(else_) filter (where flag ='640') 	as  "640",
			sum(total_big) filter (where flag ='43') 	as  "43",
			sum(total_big) filter (where flag ='603') 	as  "603",
